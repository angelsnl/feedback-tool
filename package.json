{
  "name": "claude-test",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "prepare": "svelte-kit sync || echo ''",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "migrate": "bun run migrations/runner.ts",
    "db": "sh db/start.sh",
    "docker:build": "docker build -t claude-test .",
    "docker:run": "docker run --rm -p 3000:3000 --env-file .env.docker claude-test"
  },
  "devDependencies": {
    "@sveltejs/kit": "^2.57.0",
    "@sveltejs/vite-plugin-svelte": "^7.0.0",
    "@types/node": "^25.9.1",
    "svelte": "^5.55.2",
    "svelte-adapter-bun": "^1.0.1",
    "svelte-check": "^4.4.6",
    "typescript": "^6.0.2",
    "vite": "^8.0.7"
  },
  "dependencies": {
    "postgres": "^3.4.9"
  }
}
